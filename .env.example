# Copy this file to .env.local for local development. Never commit .env.local.
# On Vercel, add the same names under Project > Settings > Environment Variables.

# Required for the "Book a Call" buttons. Your Calendly event link.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/YOUR-USERNAME/YOUR-EVENT

# Optional. Final website address, used for sharing previews. Example: https://nablabs.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional. Leave empty until real details exist.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
